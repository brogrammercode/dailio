generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrganizationType {
  GYM
  COACHING
  CLINIC
  OTHER
}

enum BranchStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSessionState {
  OPEN
  CLOSED
  CORRECTED
  VOID
}

enum AttendanceSessionSource {
  SELF
  QR_GATE
  ADMIN
  IMPORT
  SYSTEM_AUTO_CLOSE
}

enum AttendanceDerivedStatus {
  PRESENT
  LATE
  LEFT_EARLY
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  INCOMPLETE
  MANUAL
  VOID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  DRAFT
  UPCOMING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum LedgerEntryCategory {
  SUBSCRIPTION_CHARGE
  JOINING_FEE
  FINE
  DISCOUNT_CREDIT
  PAYMENT
  REFUND
  VOID_REVERSAL
  MANUAL_DEBIT
  MANUAL_CREDIT
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentRequestStatus {
  REQUESTED
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
}

enum InvitePurpose {
  BRANCH_JOIN
  PLAN_PURCHASE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  CANCELLED
}

enum AnnouncementAudience {
  ALL_ACTIVE_MEMBERS
  SELECTED_ROLES
  SELECTED_MEMBERS
}

enum AnnouncementReactionType {
  LIKE
  LOVE
  CELEBRATE
  LAUGH
  SAD
  ANGRY
}

enum FeedReactionType {
  LIKE
  LOVE
  CELEBRATE
  LAUGH
  SAD
  ANGRY
}

enum FeedPostStatus {
  ACTIVE
  HIDDEN
}

enum FeedReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationPreferenceChannel {
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum DailyJobRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  APPROVE
  REJECT
  CANCEL
  ASSIGN
  UNASSIGN
  PAUSE
  RESUME
  RENEW
  CLOCK_IN
  CLOCK_OUT
  CORRECT
  VOID
  PAYMENT_POST
  REFUND
  EXPORT
  LOGIN
  LOGOUT
}

// ============================================================
// CORE IDENTITY
// ============================================================

model User {
  id                      String     @id @default(cuid())
  name                    String
  email                   String?    @unique
  phone                   String?    @unique
  google_id               String?    @unique
  avatar_url              String?
  status                  UserStatus @default(ACTIVE)
  fcm_token               String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  date_of_birth           DateTime?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt

  members                  Member[]
  audit_logs               AuditLog[]               @relation("AuditActor")
  notifications            Notification[]
  notification_deliveries  NotificationDelivery[]
  device_tokens            UserDeviceToken[]
  notification_preferences NotificationPreference[]
  announcements_created    Announcement[]           @relation("AnnouncementActor")
  announcement_reactions   AnnouncementReaction[]
  announcement_comments    AnnouncementComment[]
  feeds_created            Feed[]                   @relation("FeedCreator")
  feed_participants_added  FeedParticipant[]        @relation("FeedParticipantAdder")
  feed_reports_reviewed    FeedReport[]             @relation("FeedReportReviewer")
  joinRequests             JoinRequest[]

  @@map("users")
}

model Member {
  id                  String       @id @default(cuid())
  user_id             String
  organization_id     String
  branch_id           String
  is_employee         Boolean      @default(false)
  role_id             String?
  manager_member_id   String?
  shift_id            String?
  subscription_id     String?
  salary_structure_id String?
  status              MemberStatus @default(ACTIVE)
  member_number       String?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  user             User                   @relation(fields: [user_id], references: [id])
  organization     Organization           @relation(fields: [organization_id], references: [id])
  branch           Branch?                @relation(fields: [branch_id], references: [id])
  role             Role?                  @relation(fields: [role_id], references: [id])
  role_assignments MemberRoleAssignment[]
  manager_member   Member?                @relation("MemberManager", fields: [manager_member_id], references: [id])
  managed_members  Member[]               @relation("MemberManager")
  shift            Shift?                 @relation(fields: [shift_id], references: [id])
  salary_structure SalaryStructure?       @relation(fields: [salary_structure_id], references: [id])

  attendance_sessions AttendanceSession[]
  attendance_streaks  AttendanceStreak[]
  attendance_policies AttendancePolicy[]
  subscriptions       Subscription[]
  ledger_entries      LedgerEntry[]
  payment_requests    PaymentRequest[]
  payment_attempts    PaymentAttempt[]

  join_requests           JoinRequest[]
  leave_requests          LeaveRequest[]
  announcement_recipients AnnouncementRecipient[]
  feed_participations     FeedParticipant[]
  feed_posts              FeedPost[]
  feed_post_reads         FeedPostRead[]
  feed_reactions          FeedReaction[]
  feed_comments           FeedComment[]
  feed_reports            FeedReport[]

  @@unique([organization_id, branch_id, user_id])
  @@index([organization_id, branch_id])
  @@index([organization_id, branch_id, status, created_at])
  @@index([organization_id, branch_id, manager_member_id])
  @@index([user_id])
  @@index([user_id, status])
  @@map("members")
}

// ============================================================
// ORGANIZATION AND LOCATION
// ============================================================

model Organization {
  id          String             @id @default(cuid())
  type        OrganizationType   @default(OTHER)
  name        String
  slug        String             @unique
  email       String?
  phone       String?
  address     String?
  logo_url    String?
  timezone    String             @default("Asia/Kolkata")
  currency    String             @default("INR")
  status      OrganizationStatus @default(DRAFT)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  archived_at DateTime?
  archived_by String?

  branches               Branch[]
  holidays               Holiday[]
  organization_members   Member[]
  roles                  Role[]
  plans                  Plan[]
  feature_flags          FeatureFlag[]
  audit_logs             AuditLog[]
  announcements          Announcement[]
  announcement_reactions AnnouncementReaction[]
  announcement_comments  AnnouncementComment[]
  feeds                  Feed[]
  feed_reactions         FeedReaction[]
  feed_comments          FeedComment[]
  feed_posts             FeedPost[]
  feed_reports           FeedReport[]
  salaryStructures       SalaryStructure[]
  payment_requests       PaymentRequest[]
  invite_tokens          InviteToken[]
  attendanceStreaks      AttendanceStreak[]

  @@map("organizations")
}

model Branch {
  id              String       @id @default(cuid())
  organization_id String
  name            String
  address         String?
  city            String?
  state           String?
  country         String       @default("IN")
  postal_code     String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  timezone        String       @default("Asia/Kolkata")
  status          BranchStatus @default(ACTIVE)
  week_start      Int          @default(1) // 1=Monday
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  archived_at     DateTime?
  archived_by     String?

  organization Organization @relation(fields: [organization_id], references: [id])

  join_requests          JoinRequest[]
  attendance_policies    AttendancePolicy[]
  attendance_sessions    AttendanceSession[]
  shifts                 Shift[]
  leave_requests         LeaveRequest[]
  attendance_streaks     AttendanceStreak[]
  holidays               Holiday[]
  subscriptions          Subscription[]
  ledger_entries         LedgerEntry[]
  payment_attempts       PaymentAttempt[]
  reminders              Reminder[]
  announcements          Announcement[]
  announcement_reactions AnnouncementReaction[]
  announcement_comments  AnnouncementComment[]
  feeds                  Feed[]
  feed_reactions         FeedReaction[]
  feed_comments          FeedComment[]
  feed_posts             FeedPost[]
  feed_reports           FeedReport[]
  members                Member[]
  plans                  Plan[]
  salaryStructures       SalaryStructure[]
  payment_requests       PaymentRequest[]
  invite_tokens          InviteToken[]
  notifications          Notification[]

  @@index([organization_id])
  @@map("branches")
}

// ============================================================
// MEMBERSHIPS
// ============================================================

model JoinRequest {
  id               String            @id @default(cuid())
  organization_id  String
  branch_id        String
  user_id          String
  member_id        String?
  status           JoinRequestStatus @default(PENDING)
  message          String?
  rejection_reason String?
  reviewed_by      String?
  reviewed_at      DateTime?
  idempotency_key  String?           @unique
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  branch Branch  @relation(fields: [branch_id], references: [id])
  member Member? @relation(fields: [member_id], references: [id])
  user   User    @relation(fields: [user_id], references: [id])

  // PostgreSQL partial unique index in the join-request migration enforces
  // only one PENDING request per user and branch while preserving history.
  @@index([organization_id])
  @@index([branch_id])
  @@index([user_id])
  @@index([member_id])
  @@map("join_requests")
}

// ============================================================
// ROLES AND PERMISSIONS
// ============================================================

model Role {
  id              String   @id @default(cuid())
  organization_id String
  branch_id       String?
  system_key      String? // OWNER, ADMIN, MEMBER ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â null for custom
  name            String
  description     String?
  is_protected    Boolean  @default(false)
  is_system       Boolean  @default(false)
  permissions     String[] @default([])
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization        Organization           @relation(fields: [organization_id], references: [id])
  role_members        Member[]
  member_assignments  MemberRoleAssignment[]
  attendance_policies AttendancePolicy[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("roles")
}

model MemberRoleAssignment {
  id              String    @id @default(cuid())
  organization_id String
  branch_id       String
  member_id       String
  role_id         String
  priority        Int       @default(100)
  effective_from  DateTime  @default(now())
  effective_to    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  member Member @relation(fields: [member_id], references: [id])
  role   Role   @relation(fields: [role_id], references: [id])

  @@unique([member_id, role_id, effective_from])
  @@index([organization_id, branch_id, member_id, priority])
  @@index([organization_id, branch_id, role_id])
  @@map("member_role_assignments")
}

// ============================================================
// ATTENDANCE
// ============================================================

model AttendancePolicy {
  id                          String    @id @default(cuid())
  organization_id             String
  branch_id                   String
  role_id                     String? // null = location default, set = role override
  member_id                   String? // null unless this is a direct member override
  version                     Int       @default(1)
  effective_from              DateTime
  effective_to                DateTime?
  punch_required              Boolean   @default(true)
  qr_scan_on_clock_in         Boolean   @default(false)
  qr_scan_on_clock_out        Boolean   @default(false)
  selfie_on_clock_in          Boolean   @default(false)
  selfie_on_clock_out         Boolean   @default(false)
  location_on_clock_in        Boolean   @default(false)
  location_on_clock_out       Boolean   @default(false)
  geofence_enabled            Boolean   @default(false)
  geofence_lat                Float?
  geofence_lng                Float?
  geofence_radius_meters      Int?
  geofence_accuracy_threshold Float?
  shift_enforcement_enabled   Boolean   @default(false)
  early_arrival_minutes       Int       @default(30)
  late_grace_minutes          Int       @default(15)
  min_session_minutes         Int       @default(0)
  max_open_session_hours      Int       @default(24)
  allow_manual_entry          Boolean   @default(false)
  allow_offline_capture       Boolean   @default(false)
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  branch Branch  @relation(fields: [branch_id], references: [id])
  role   Role?   @relation(fields: [role_id], references: [id])
  member Member? @relation(fields: [member_id], references: [id])

  @@index([organization_id, branch_id])
  @@index([organization_id, branch_id, role_id])
  @@index([organization_id, branch_id, member_id])
  @@map("attendance_policies")
}

model AttendanceSession {
  id                  String                   @id @default(cuid())
  organization_id     String
  branch_id           String
  member_id           String
  policy_version      Int
  policy_snapshot     Json?
  branch_timezone     String?
  state               AttendanceSessionState   @default(OPEN)
  source              AttendanceSessionSource  @default(SELF)
  derived_status      AttendanceDerivedStatus?
  worked_minutes      Int?
  late_minutes        Int?
  early_leave_minutes Int?
  shift_id            String?
  shift_snapshot      Json?
  clock_in_at         DateTime // server time
  clock_in_client_at  DateTime? // client captured time
  clock_in_timezone   String?
  clock_out_at        DateTime?
  clock_out_client_at DateTime?
  clock_out_timezone  String?
  clock_out_source    String?
  corrected_at        DateTime?
  corrected_by        String?
  correction_reason   String?
  correction_version  Int                      @default(0)
  idempotency_key_in  String?                  @unique
  idempotency_key_out String?                  @unique
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt

  branch      Branch                 @relation(fields: [branch_id], references: [id])
  member      Member?                @relation(fields: [member_id], references: [id])
  evidence    AttendanceEvidence[]
  corrections AttendanceCorrection[]

  @@index([organization_id, branch_id])
  @@index([organization_id, branch_id, clock_in_at, id])
  @@index([member_id])
  @@map("attendance_sessions")
}

model AttendanceEvidence {
  id                       String   @id @default(cuid())
  session_id               String
  organization_id          String
  type                     String // SELFIE_IN, SELFIE_OUT, LOCATION_IN, LOCATION_OUT
  asset_id                 String? // ref to MediaAsset
  latitude                 Float?
  longitude                Float?
  accuracy                 Float?
  geofence_distance_meters Float?
  device_metadata          Json?
  ip_address               String?
  created_at               DateTime @default(now())

  session AttendanceSession @relation(fields: [session_id], references: [id])
  asset   MediaAsset?       @relation(fields: [asset_id], references: [id])

  @@index([session_id])
  @@index([organization_id])
  @@map("attendance_evidence")
}

model AttendanceCorrection {
  id                       String                   @id @default(cuid())
  session_id               String
  organization_id          String
  branch_id                String
  version                  Int
  actor_id                 String
  previous_clock_in_at     DateTime
  previous_clock_out_at    DateTime?
  previous_state           AttendanceSessionState
  previous_derived_status  AttendanceDerivedStatus?
  corrected_clock_in_at    DateTime
  corrected_clock_out_at   DateTime?
  corrected_state          AttendanceSessionState
  corrected_derived_status AttendanceDerivedStatus?
  reason                   String
  created_at               DateTime                 @default(now())

  session AttendanceSession @relation(fields: [session_id], references: [id])

  @@unique([session_id, version])
  @@index([organization_id, branch_id])
  @@index([session_id, created_at])
  @@map("attendance_corrections")
}

// ============================================================
// WORKFORCE
// ============================================================

model Shift {
  id              String    @id @default(cuid())
  organization_id String
  branch_id       String
  name            String
  start_time      String // HH:mm local
  end_time        String // HH:mm local
  is_overnight    Boolean   @default(false)
  break_minutes   Int       @default(0)
  grace_in_min    Int       @default(0)
  grace_out_min   Int       @default(0)
  week_days       Int[] // 1=Mon..7=Sun
  active_from     DateTime?
  active_to       DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  branch        Branch   @relation(fields: [branch_id], references: [id])
  shift_members Member[]

  @@index([organization_id, branch_id])
  @@map("shifts")
}

model LeaveRequest {
  id              String             @id @default(cuid())
  organization_id String
  branch_id       String
  member_id       String
  start_date      DateTime // local date
  end_date        DateTime // local date
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  reviewed_by     String?
  reviewed_at     DateTime?
  review_note     String?
  idempotency_key String?            @unique
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  branch Branch  @relation(fields: [branch_id], references: [id])
  member Member? @relation(fields: [member_id], references: [id])

  @@index([organization_id, branch_id])
  @@index([member_id])
  @@map("leave_requests")
}

model Holiday {
  id                 String    @id @default(cuid())
  organization_id    String
  branch_id          String?
  name               String
  // Legacy compatibility fields. New clients use dates/recurring_weekdays.
  date               DateTime? // first explicit local date, legacy
  end_date           DateTime? // last date for a contiguous range, legacy
  dates              Json      @default("[]") // explicit local dates as YYYY-MM-DD strings
  recurring_weekdays Json      @default("[]") // ISO weekdays: 1 Monday .. 7 Sunday
  is_recurring       Boolean   @default(false)
  idempotency_key    String?   @unique
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])

  @@index([organization_id])
  @@map("holidays")
}

model AttendanceStreak {
  id                   String    @id @default(cuid())
  organization_id      String
  branch_id            String
  member_id            String
  current_streak       Int       @default(0)
  best_streak          Int       @default(0)
  last_attendance_date DateTime? @db.Date
  calculated_for_date  DateTime  @db.Date
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch       @relation(fields: [branch_id], references: [id])
  member       Member       @relation(fields: [member_id], references: [id])

  @@unique([organization_id, branch_id, member_id])
  @@index([organization_id, branch_id, current_streak])
  @@map("attendance_streaks")
}

// ============================================================
// PLANS AND SUBSCRIPTIONS
// ============================================================

model Plan {
  id                String   @id @default(cuid())
  organization_id   String
  name              String
  description       String?
  duration_days     Int
  amount_minor_unit Int // paise
  currency          String   @default("INR")
  joining_fee_minor Int      @default(0)
  tax_percent       Float    @default(0)
  discount_percent  Float    @default(0)
  grace_days        Int      @default(0)
  is_active         Boolean  @default(true)
  branch_id         String?
  metadata          Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organization  Organization   @relation(fields: [organization_id], references: [id])
  branch        Branch?        @relation(fields: [branch_id], references: [id])
  subscriptions Subscription[]
  invite_tokens InviteToken[]

  @@index([organization_id])
  @@index([organization_id, branch_id, created_at])
  @@map("plans")
}

model InviteToken {
  id              String        @id @default(cuid())
  organization_id String
  branch_id       String
  plan_id         String?
  purpose         InvitePurpose
  token_hash      String        @unique
  expires_at      DateTime?
  revoked_at      DateTime?
  created_by      String
  created_at      DateTime      @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch       @relation(fields: [branch_id], references: [id])
  plan         Plan?        @relation(fields: [plan_id], references: [id])

  @@index([organization_id, branch_id, purpose])
  @@index([plan_id, purpose])
  @@index([expires_at])
  @@map("invite_tokens")
}

model Subscription {
  id                  String             @id @default(cuid())
  organization_id     String
  branch_id           String
  member_id           String
  plan_id             String
  plan_snapshot       Json // immutable copy of plan terms at assignment time
  status              SubscriptionStatus @default(DRAFT)
  start_date          DateTime
  end_date            DateTime
  agreed_amount_minor Int
  discount_minor      Int                @default(0)
  currency            String             @default("INR")
  due_date            DateTime?
  created_by          String?
  paused_at           DateTime?
  paused_by           String?
  cancelled_at        DateTime?
  cancelled_by        String?
  cancel_reason       String?
  renewed_from_id     String?
  idempotency_key     String?            @unique
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  branch           Branch           @relation(fields: [branch_id], references: [id])
  member           Member?          @relation(fields: [member_id], references: [id])
  plan             Plan             @relation(fields: [plan_id], references: [id])
  ledger_entries   LedgerEntry[]
  payment_requests PaymentRequest[]

  @@index([organization_id, branch_id])
  @@index([organization_id, branch_id, member_id, status, end_date])
  @@index([member_id])
  @@map("subscriptions")
}

// ============================================================
// FINANCIAL LEDGER
// ============================================================

model LedgerEntry {
  id                String              @id @default(cuid())
  organization_id   String
  branch_id         String
  member_id         String
  subscription_id   String?
  category          LedgerEntryCategory
  amount_minor_unit Int // positive = debit (money owed), negative = credit
  currency          String              @default("INR")
  description       String?
  due_date          DateTime?
  created_by        String?
  reversed_by_id    String?             @unique // links to compensating entry
  idempotency_key   String?             @unique
  created_at        DateTime            @default(now())

  branch       Branch              @relation(fields: [branch_id], references: [id])
  member       Member?             @relation(fields: [member_id], references: [id])
  subscription Subscription?       @relation(fields: [subscription_id], references: [id])
  allocations  PaymentAllocation[]

  @@index([organization_id, branch_id])
  @@index([organization_id, branch_id, member_id, subscription_id])
  @@index([member_id])
  @@map("ledger_entries")
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  organization_id  String
  branch_id        String
  member_id        String?
  amount           Int
  currency         String               @default("INR")
  method           String // CASH, CARD, UPI, GATEWAY
  status           PaymentAttemptStatus @default(PENDING)
  gateway_id       String?
  gateway_response Json?
  posted_by        String?
  posted_at        DateTime?
  idempotency_key  String?              @unique
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  branch          Branch              @relation(fields: [branch_id], references: [id])
  member          Member?             @relation(fields: [member_id], references: [id])
  allocations     PaymentAllocation[]
  receipt         Receipt?
  payment_request PaymentRequest?

  @@index([organization_id, branch_id])
  @@map("payment_attempts")
}

model PaymentRequest {
  id                 String               @id @default(cuid())
  organization_id    String
  branch_id          String
  member_id          String
  subscription_id    String?
  amount_minor_unit  Int
  currency           String               @default("INR")
  method             String
  reference          String?
  note               String?
  status             PaymentRequestStatus @default(REQUESTED)
  rejection_reason   String?
  reviewer_id        String?
  reviewed_at        DateTime?
  payment_attempt_id String?              @unique
  idempotency_key    String               @unique
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  organization    Organization      @relation(fields: [organization_id], references: [id])
  branch          Branch            @relation(fields: [branch_id], references: [id])
  member          Member            @relation(fields: [member_id], references: [id])
  subscription    Subscription?     @relation(fields: [subscription_id], references: [id])
  payment_attempt PaymentAttempt?   @relation(fields: [payment_attempt_id], references: [id])
  evidence        PaymentEvidence[]

  @@index([organization_id, branch_id, status])
  @@index([organization_id, branch_id, member_id, status, created_at])
  @@index([member_id, status])
  @@index([subscription_id])
  @@map("payment_requests")
}

model PaymentEvidence {
  id                 String   @id @default(cuid())
  payment_request_id String
  organization_id    String
  branch_id          String
  uploaded_by        String
  storage_key        String
  content_type       String
  size_bytes         Int?
  reference          String?
  note               String?
  created_at         DateTime @default(now())

  payment_request PaymentRequest @relation(fields: [payment_request_id], references: [id])

  @@index([organization_id, branch_id])
  @@index([payment_request_id])
  @@map("payment_evidence")
}

model PaymentAllocation {
  id                 String   @id @default(cuid())
  payment_attempt_id String
  ledger_entry_id    String
  allocated_amount   Int
  created_at         DateTime @default(now())

  payment_attempt PaymentAttempt @relation(fields: [payment_attempt_id], references: [id])
  ledger_entry    LedgerEntry    @relation(fields: [ledger_entry_id], references: [id])

  @@unique([payment_attempt_id, ledger_entry_id])
  @@map("payment_allocations")
}

model Receipt {
  id                 String   @id @default(cuid())
  organization_id    String
  branch_id          String
  payment_attempt_id String   @unique
  receipt_number     String // unique within organization
  issued_at          DateTime @default(now())
  metadata           Json?

  payment_attempt PaymentAttempt @relation(fields: [payment_attempt_id], references: [id])

  @@unique([receipt_number, organization_id])
  @@index([organization_id, branch_id])
  @@map("receipts")
}

// ============================================================
// REMINDERS
// ============================================================

model Reminder {
  id                 String    @id @default(cuid())
  organization_id    String
  branch_id          String
  member_id          String?
  type               String // FEE_DUE, FEE_OVERDUE, SUBSCRIPTION_EXPIRY, CUSTOM
  message            String
  scheduled_at       DateTime
  channel            String    @default("IN_APP")
  status             String    @default("PENDING")
  sent_at            DateTime?
  linked_entity_type String?
  linked_entity_id   String?
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  branch Branch @relation(fields: [branch_id], references: [id])

  @@index([organization_id, branch_id])
  @@map("reminders")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id              String               @id @default(cuid())
  organization_id String
  branch_id       String?
  title           String
  body            String
  content         Json                 @default("[]")
  priority        Int                  @default(0)
  status          AnnouncementStatus   @default(DRAFT)
  audience        AnnouncementAudience @default(ALL_ACTIVE_MEMBERS)
  publish_at      DateTime?
  expires_at      DateTime?
  automation_key  String?              @unique
  created_by      String?
  updated_by      String?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id])
  branch       Branch?                 @relation(fields: [branch_id], references: [id])
  actor        User?                   @relation("AnnouncementActor", fields: [created_by], references: [id])
  recipients   AnnouncementRecipient[]
  reactions    AnnouncementReaction[]
  comments     AnnouncementComment[]

  @@index([organization_id])
  @@index([organization_id, branch_id, status, created_at])
  @@map("announcements")
}

model AnnouncementReaction {
  id              String                   @id @default(cuid())
  organization_id String
  branch_id       String?
  announcement_id String
  user_id         String
  reaction        AnnouncementReactionType
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([announcement_id, user_id])
  @@index([organization_id, branch_id, announcement_id])
  @@map("announcement_reactions")
}

model AnnouncementComment {
  id              String    @id @default(cuid())
  organization_id String
  branch_id       String?
  announcement_id String
  user_id         String
  body            String
  reply_to_id     String?
  idempotency_key String?   @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  organization Organization          @relation(fields: [organization_id], references: [id])
  branch       Branch?               @relation(fields: [branch_id], references: [id])
  announcement Announcement          @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [user_id], references: [id])
  reply_to     AnnouncementComment?  @relation("AnnouncementCommentReplies", fields: [reply_to_id], references: [id])
  replies      AnnouncementComment[] @relation("AnnouncementCommentReplies")

  @@index([organization_id, branch_id, announcement_id, created_at])
  @@index([reply_to_id])
  @@map("announcement_comments")
}

model AnnouncementRecipient {
  id              String    @id @default(cuid())
  announcement_id String
  member_id       String
  read_at         DateTime?
  created_at      DateTime  @default(now())

  announcement Announcement @relation(fields: [announcement_id], references: [id])
  member       Member?      @relation(fields: [memberId], references: [id])
  memberId     String?

  @@unique([announcement_id, member_id])
  @@map("announcement_recipients")
}

// ============================================================
// PRIVATE FEEDS
// ============================================================

model Feed {
  id                    String   @id @default(cuid())
  organization_id       String
  branch_id             String
  name                  String
  participants_can_post Boolean  @default(false)
  post_timeout          Int?
  disbanded             Boolean  @default(false)
  report_threshold      Int      @default(3)
  created_by_user_id    String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  branch       Branch            @relation(fields: [branch_id], references: [id])
  created_by   User              @relation("FeedCreator", fields: [created_by_user_id], references: [id])
  participants FeedParticipant[]
  posts        FeedPost[]

  @@unique([organization_id, branch_id, name])
  @@index([organization_id, branch_id, disbanded])
  @@map("feeds")
}

model FeedParticipant {
  id               String    @id @default(cuid())
  feed_id          String
  member_id        String
  added_by_user_id String?
  created_at       DateTime  @default(now())
  removed_at       DateTime?

  feed     Feed   @relation(fields: [feed_id], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [member_id], references: [id])
  added_by User?  @relation("FeedParticipantAdder", fields: [added_by_user_id], references: [id])

  @@unique([feed_id, member_id])
  @@index([member_id, removed_at])
  @@map("feed_participants")
}

model FeedPost {
  id              String         @id @default(cuid())
  organization_id String
  branch_id       String
  feed_id         String
  title           String
  body            String
  content         Json           @default("[]")
  member_id       String
  status          FeedPostStatus @default(ACTIVE)
  expires_at      DateTime?
  idempotency_key String?        @unique
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  organization Organization   @relation(fields: [organization_id], references: [id])
  branch       Branch         @relation(fields: [branch_id], references: [id])
  feed         Feed           @relation(fields: [feed_id], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [member_id], references: [id])
  read_by      FeedPostRead[]
  reactions    FeedReaction[]
  comments     FeedComment[]
  reports      FeedReport[]

  @@index([organization_id, branch_id, feed_id, created_at])
  @@index([organization_id, branch_id, feed_id, status, created_at])
  @@index([feed_id, status, expires_at])
  @@map("feed_posts")
}

model FeedPostRead {
  id           String   @id @default(cuid())
  feed_post_id String
  member_id    String
  read_at      DateTime @default(now())

  post   FeedPost @relation(fields: [feed_post_id], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [member_id], references: [id])

  @@unique([feed_post_id, member_id])
  @@map("feed_post_reads")
}

model FeedReaction {
  id              String           @id @default(cuid())
  organization_id String
  branch_id       String
  feed_post_id    String
  member_id       String
  reaction        FeedReactionType
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch       @relation(fields: [branch_id], references: [id])
  post         FeedPost     @relation(fields: [feed_post_id], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [member_id], references: [id])

  @@unique([feed_post_id, member_id])
  @@index([organization_id, branch_id, feed_post_id])
  @@map("feed_reactions")
}

model FeedComment {
  id              String    @id @default(cuid())
  organization_id String
  branch_id       String
  feed_post_id    String
  member_id       String
  body            String
  reply_to_id     String?
  idempotency_key String?   @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  organization Organization  @relation(fields: [organization_id], references: [id])
  branch       Branch        @relation(fields: [branch_id], references: [id])
  post         FeedPost      @relation(fields: [feed_post_id], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [member_id], references: [id])
  reply_to     FeedComment?  @relation("FeedCommentReplies", fields: [reply_to_id], references: [id])
  replies      FeedComment[] @relation("FeedCommentReplies")

  @@index([organization_id, branch_id, feed_post_id, created_at])
  @@index([reply_to_id])
  @@map("feed_comments")
}

model FeedReport {
  id                  String           @id @default(cuid())
  organization_id     String
  branch_id           String
  feed_post_id        String
  reporter_member_id  String
  reason              String
  status              FeedReportStatus @default(OPEN)
  reviewed_by_user_id String?
  reviewed_at         DateTime?
  created_at          DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch       @relation(fields: [branch_id], references: [id])
  post         FeedPost     @relation(fields: [feed_post_id], references: [id], onDelete: Cascade)
  reporter     Member       @relation(fields: [reporter_member_id], references: [id])
  reviewed_by  User?        @relation("FeedReportReviewer", fields: [reviewed_by_user_id], references: [id])

  @@unique([feed_post_id, reporter_member_id])
  @@index([organization_id, branch_id, status])
  @@map("feed_reports")
}

// ============================================================
// MEDIA, NOTIFICATIONS, AUDIT
// ============================================================

model MediaAsset {
  id              String   @id @default(cuid())
  organization_id String
  owner_type      String // ATTENDANCE_SELFIE, ORGANIZATION_LOGO, etc.
  owner_id        String
  storage_key     String   @unique // S3 object key
  content_type    String
  size_bytes      Int?
  uploaded_by     String?
  created_at      DateTime @default(now())

  attendance_evidence AttendanceEvidence[]

  @@index([organization_id])
  @@map("media_assets")
}

model Notification {
  id              String              @id @default(cuid())
  user_id         String
  organization_id String?
  branch_id       String?
  event_type      String?
  entity_type     String?
  entity_id       String?
  title           String
  body            String
  channel         NotificationChannel @default(IN_APP)
  status          NotificationStatus  @default(PENDING)
  dedupe_key      String?             @unique
  data            Json?
  read_at         DateTime?
  sent_at         DateTime?
  created_at      DateTime            @default(now())

  user       User                   @relation(fields: [user_id], references: [id])
  branch     Branch?                @relation(fields: [branch_id], references: [id])
  deliveries NotificationDelivery[]

  @@index([user_id, created_at])
  @@index([user_id, read_at, created_at])
  @@index([organization_id, branch_id, created_at])
  @@index([event_type, entity_id])
  @@map("notifications")
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  notification_id     String
  user_id             String
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(PENDING)
  attempt_count       Int                        @default(0)
  provider_message_id String?
  last_error_code     String?
  last_attempt_at     DateTime?
  delivered_at        DateTime?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([notification_id, channel, user_id])
  @@index([user_id, status, created_at])
  @@index([status, last_attempt_at])
  @@map("notification_deliveries")
}

model UserDeviceToken {
  id           String   @id @default(cuid())
  user_id      String
  token        String   @unique
  platform     String?
  app_version  String?
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, last_seen_at])
  @@map("user_device_tokens")
}

model NotificationPreference {
  id         String                        @id @default(cuid())
  user_id    String
  event_type String
  channel    NotificationPreferenceChannel
  enabled    Boolean                       @default(true)
  created_at DateTime                      @default(now())
  updated_at DateTime                      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_type, channel])
  @@index([user_id, event_type])
  @@map("notification_preferences")
}

model DailyJobRun {
  id            String            @id @default(cuid())
  job_key       String
  business_date DateTime          @db.Date
  status        DailyJobRunStatus @default(RUNNING)
  lease_until   DateTime?
  attempt_count Int               @default(1)
  started_at    DateTime          @default(now())
  completed_at  DateTime?
  last_error    String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  @@unique([job_key, business_date])
  @@index([status, lease_until])
  @@map("daily_job_runs")
}

model AuditLog {
  id              String      @id @default(cuid())
  organization_id String?
  branch_id       String?
  actor_id        String?
  action          AuditAction
  target_type     String
  target_id       String
  request_id      String?
  ip_address      String?
  before_state    Json?
  after_state     Json?
  reason          String?
  source          String? // API, SYSTEM, IMPORT
  created_at      DateTime    @default(now())

  organization Organization? @relation(fields: [organization_id], references: [id])
  actor        User?         @relation("AuditActor", fields: [actor_id], references: [id])

  @@index([organization_id])
  @@index([actor_id])
  @@index([target_type, target_id])
  @@map("audit_logs")
}

model FeatureFlag {
  id              String   @id @default(cuid())
  organization_id String?
  branch_id       String?
  key             String
  enabled         Boolean  @default(false)
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization? @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, branch_id, key])
  @@map("feature_flags")
}

// ============================================================
// PAYROLL & SALARY
// ============================================================

model SalaryStructure {
  id              String   @id @default(cuid())
  organization_id String
  branch_id       String?
  name            String
  amount          Int
  earnings        Json     @default("[]")
  deductions      Json     @default("[]")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  members      Member[]

  @@index([organization_id, branch_id])
  @@map("salary_structures")
}
